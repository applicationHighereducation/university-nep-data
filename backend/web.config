<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Use iisnode to run Node.js -->
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Rewrite all requests to index.js -->
    <rewrite>
      <rules>
        <rule name="Node.js" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Optional: enable logging for iisnode -->
    <iisnode 
      loggingEnabled="true"
      devErrorsEnabled="true"
    />

    <!-- Static file handling -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Set Node environment -->
    <environmentVariables>
      <add name="NODE_ENV" value="production" />
      <!-- If you want to specify .env path manually, you can add:
      <add name="DOTENV_CONFIG_PATH" value="C:\path\to\.env" />
      -->
    </environmentVariables>

    <!-- Allow larger uploads if needed -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50MB -->
      </requestFiltering>
    </security>

    <!-- Optional: Disable directory browsing -->
    <directoryBrowse enabled="false" />

    <!-- Optional: Compress responses -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>
</configuration>